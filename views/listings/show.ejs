<% layout('/layouts/boilerplate') %>

  <div class="container mt-3">

    <div class="row mt-3 mb-3">
      <div class="col-8 offset-2">
        <h3 class="fw-bold fs-2">
          <%= listing.title %>
        </h3>
        <p class="text-muted fw-semibold">
          <i class="fas fa-map-marker-alt text-danger"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
      </div>
    </div>

    <div class="row">
      <div class="col-8 offset-2">
        <div class="card listing-card shadow-none border-0">
          <img src="<%= listing.image.url %>" class="card-img-top rounded-4 w-100" alt="listing_image"
            style="height: 450px; object-fit: cover;">
        </div>
      </div>
    </div>

    <div class="row mt-4">

      <div class="col-md-6 offset-md-2">

        <div class="d-flex align-items-center justify-content-between border-bottom pb-4 mb-4">
          <div>
            <h5 class="fw-bold">Hosted by <%= listing.owner.username %>
            </h5>
            <p class="text-muted mb-0">Superhost &middot; 2 years hosting</p>
          </div>
          <div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center"
            style="width: 50px; height: 50px; font-size: 1.5rem;">
            <%= listing.owner.username.charAt(0).toUpperCase() %>
          </div>
        </div>

        <div class="mb-4 border-bottom pb-4">
          <p class="lead text-dark" style="font-size: 1rem; line-height: 1.6;">
            <%= listing.description %>
          </p>
        </div>

        <div class="mb-5 border-bottom pb-4">
          <h5 class="fw-bold mb-3">What this place offers</h5>
          <div class="row">
            <div class="col-6 mb-2"><i class="fas fa-wifi me-3 text-muted"></i> Wifi</div>
            <div class="col-6 mb-2"><i class="fas fa-car me-3 text-muted"></i> Free parking</div>
            <div class="col-6 mb-2"><i class="fas fa-tv me-3 text-muted"></i> TV</div>
            <div class="col-6 mb-2"><i class="fas fa-paw me-3 text-muted"></i> Pets allowed</div>
          </div>
        </div>

        <% if(currUser) { %>
          <div class="mb-4">
            <h4 class="fw-bold">Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation mt-3">
              <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                  required></textarea>
                <div class="invalid-feedback">Please submit some comments for review</div>
              </div>
              <button class="btn btn-outline-dark">Submit</button>
            </form>
          </div>
          <% } %>

            <% if(listing.reviews.length> 0) { %>
              <hr>
              <div class="row">
                <p><b>All Reviews</b></p>
                <% for(review of listing.reviews) { %>
                  <div class="card col-5 ms-3 mb-3 border-0 bg-light p-3 rounded-3">
                    <div class="card-body">
                      <h5 class="card-title fw-bold">@<%= review.author.username %>
                      </h5>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                      <p class="card-text">
                        <%= review.comment %>
                      </p>
                      <% if(currUser && currUser._id.equals(review.author._id)) {%>
                        <form class="mb-3" method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                          <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                  </div>
                  <% } %>
              </div>
              <% } %>
      </div>

      <div class="col-md-4">
        <div class="card shadow border-0 rounded-4 p-4 position-sticky" style="top: 100px;">
          <div class="d-flex justify-content-between align-items-baseline mb-4">
            <div>
              <span class="fs-3 fw-bold">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
              <span class="text-muted"> night</span>
            </div>
            <div class="text-muted fs-6">
              <i class="fas fa-star text-warning"></i> 4.8 &middot; <u>
                <%= listing.reviews.length %> reviews
              </u>
            </div>
          </div>

          <form action="/listings/<%= listing._id %>/book" method="POST">
            <div class="border rounded-3 mb-3 overflow-hidden">
              <div class="d-flex border-bottom">
                <div class="p-2 w-50 border-end">
                  <label class="small fw-bold text-uppercase d-block text-muted"
                    style="font-size: 0.7rem;">Check-in</label>
                  <input type="date" name="booking[checkIn]" class="form-control border-0 p-0 shadow-none" required>
                </div>
                <div class="p-2 w-50">
                  <label class="small fw-bold text-uppercase d-block text-muted"
                    style="font-size: 0.7rem;">Check-out</label>
                  <input type="date" name="booking[checkOut]" class="form-control border-0 p-0 shadow-none" required>
                </div>
              </div>
              <div class="p-2">
                <label class="small fw-bold text-uppercase d-block text-muted" style="font-size: 0.7rem;">Guests</label>
                <select name="booking[guests]" class="form-select border-0 p-0 shadow-none text-dark">
                  <option value="1">1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                </select>
              </div>
            </div>

            <button class="btn btn-danger w-100 py-3 fw-bold rounded-3" style="background: #ff385c;">Reserve</button>
            <div class="text-center mt-3"><small class="text-muted">You won't be charged yet</small></div>

            <div class="mt-4 pt-3 border-top">
              <div class="d-flex justify-content-between mb-2">
                <span class="text-decoration-underline">&#8377;<%= listing.price %> x 5 nights</span>
                <span>&#8377;<%= (listing.price * 5).toLocaleString("en-IN") %></span>
              </div>
              <div class="d-flex justify-content-between mb-2">
                <span class="text-decoration-underline">Service fee</span>
                <span>&#8377;2,500</span>
              </div>
              <hr>
              <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Total before taxes</span>
                <span>&#8377;<%= (listing.price * 5 + 2500).toLocaleString("en-IN") %></span>
              </div>
            </div>
          </form>

          <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="mt-4 pt-3 border-top text-center">
              <p class="text-muted small">Owner Controls</p>
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm me-2">Edit</a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-outline-danger btn-sm">Delete</button>
              </form>
            </div>
            <% } %>

        </div>
      </div>
    </div>



  </div>